{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

(symfony) {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# Both sites import this snippet: the shared name makes them one hub
		# (same transport), Symfony publishing on php:80 and browsers subscribing
		# on SERVER_NAME
		name lethalbingo
		# Messages are kept on disk: a browser reconnecting after a network drop
		# sends its last received event ID and gets the messages it missed
		transport bolt {
			path /data/mercure.db
		}
		# Symfony is the only token issuer: the same key signs and checks every
		# Mercure JWT (MERCURE_JWT_SECRET, also used by Symfony to publish)
		issuer https://lethalbingo.app {
			publisher {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
			subscriber {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
		}
		# Expected token audience, the "aud" claim Symfony derives from public_url
		resource_identifier {$MERCURE_PUBLIC_URL}
		# Anonymous subscribers are wanted: players follow a game without an
		# account. Messages only say which part of the page to refresh; game
		# content comes from the filtered Live Component reload, never Mercure.
		anonymous
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	# Security headers sent with every response, static files included. The
	# Content-Security-Policy is set by Symfony (ContentSecurityPolicyListener) so the
	# profiler toolbar can add its nonces in dev.
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Cross-Origin-Opener-Policy "same-origin"
		# Disable Topics tracking and the browser features the app never uses
		?Permissions-Policy "browsing-topics=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}

	# Development only (compose.override.yaml): proxy to the Vite dev server
	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	handle {
		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController

		file_server {
			hide *.php
		}
	}
}

{$SERVER_NAME:localhost} {
	# Development only (compose.override.yaml): locally trusted certificate
	{$CADDY_SERVER_TLS}

	import symfony
}

php:80 {
	import symfony
}
