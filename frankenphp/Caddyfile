{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}

		worker {
			file ./public/index.php
			env APP_RUNTIME Runtime\FrankenPhpSymfony\Runtime
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

(symfony) {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# The same key signs and checks every Mercure JWT (MERCURE_JWT_SECRET,
		# also used by Symfony to publish)
		publisher_jwt {env.MERCURE_JWT_SECRET} {env.MERCURE_PUBLISHER_JWT_ALG}
		subscriber_jwt {env.MERCURE_JWT_SECRET} {env.MERCURE_SUBSCRIBER_JWT_ALG}
		# Anonymous subscribers are wanted: players follow a game without an
		# account. Updates only carry refresh signals, never game content.
		anonymous
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	# Security headers sent with every response, static files included. The
	# Content-Security-Policy is set by Symfony (ContentSecurityPolicyListener) so the
	# profiler toolbar can add its nonces in dev.
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Cross-Origin-Opener-Policy "same-origin"
		# Disable Topics tracking and the browser features the app never uses
		?Permissions-Policy "browsing-topics=(), camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}

	# Development only (compose.override.yaml): proxy to the Vite dev server
	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	handle {
		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController

		file_server {
			hide *.php
		}
	}
}

{$SERVER_NAME:localhost} {
	# Development only (compose.override.yaml): locally trusted certificate
	{$CADDY_SERVER_TLS}

	import symfony
}

php:80 {
	import symfony
}
