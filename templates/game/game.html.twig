{% extends 'layouts/base.html.twig' %}

{% block body_classes %}d-flex flex-column{% endblock %}

{% block body %}
    <div class="position-fixed top-0 end-0 mt-3 me-3 d-flex gap-3 z-1">
        {% if is_granted('ROLE_REFEREE') %}
            <a href="{{ path('app_referee_game_edit', {id: game.id}) }}" class="btn btn-icon btn-primary"
               aria-label="Éditer la partie" title="Éditer la partie">
                {{ ux_icon('mdi:pencil', {height: '24', width: '24'}) }}
            </a>
        {% endif %}

        <a href="{{ path('app_home') }}" class="btn btn-icon btn-primary" aria-label="Retour à l'accueil"
           title="Retour à l'accueil">
            {{ ux_icon('mdi:home', {height: '24', width: '24'}) }}
        </a>
    </div>

    {% if is_granted('ROLE_REFEREE') %}
        <div {{ stimulus_controller('game--game-notes', {
            gameId: game.id,
            saveUrl: path('app_game_save_notes', {id: game.id}),
            csrfToken: csrf_token('save-notes-' ~ game.id),
        }) }}>
            <div class="notes-sidebar" {{ stimulus_target('game--game-notes', 'panel') }}>
                <div class="card h-100 border-0 rounded-0">
                    <div class="card-status-top bg-green"></div>
                    <div class="card-header">
                        <h3 class="card-title">Notes</h3>
                    </div>
                    <div class="card-body">
                    <textarea
                            class="form-control resize-vertical"
                            rows="50"
                            placeholder="Prenez des notes ici..."
                        {{ stimulus_target('game--game-notes', 'notes') }}
                        data-action="input->game--game-notes#saveNotes resize->game--game-notes#saveTextareaHeight"
                    >{{ game.notes }}</textarea>
                        <div class="text-muted small mt-2" {{ stimulus_target('game--game-notes', 'status') }}>
                            Notes sauvegardées automatiquement
                        </div>
                    </div>
                </div>
            </div>

            <button
                    type="button"
                    class="btn btn-icon btn-primary notes-toggle-btn"
                    {{ stimulus_target('game--game-notes', 'toggle') }}
                    data-action="click->game--game-notes#togglePanel"
                    aria-label="Afficher/masquer les notes"
                    title="Afficher les notes">
                {{ ux_icon('mdi:note-text', {height: '24', width: '24'}) }}
            </button>
        </div>
    {% endif %}

    {{ component('GameFrame', {
        game: game,
        squares: squares
    }) }}
{% endblock %}
