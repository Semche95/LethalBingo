{% extends 'layouts/base.html.twig' %}

{% block body_classes %}d-flex flex-column game-page{% endblock %}

{% block body %}
    {# Beside the history of the referee on a wide screen, not under it #}
    <div class="position-fixed top-0 end-0 mt-3 me-3 d-flex gap-2 z-1{{ is_granted('ROLE_REFEREE') ? ' game-top-actions-beside-history' }}">
        <a href="{{ path('app_home') }}" class="btn btn-icon btn-overlay" aria-label="Retour à l'accueil"
           title="Retour à l'accueil">
            {{ ux_icon('mdi:home', {height: '20', width: '20'}) }}
        </a>
    </div>

    {% if is_granted('ROLE_REFEREE') %}
        <div {{ stimulus_controller('game--game-notes', {
            gameId: game.id,
            saveUrl: path('app_game_save_notes', {id: game.id}),
        }) }}>
            {{ component('CsrfInput', {
                tokenId: 'save-notes-' ~ game.id,
                'data-game--game-notes-target': 'token',
            }) }}
            <div class="notes-sidebar" {{ stimulus_target('game--game-notes', 'panel') }}>
                <h3 class="hud-label hud-label-green m-0">Notes</h3>
                <textarea
                        class="form-control resize-vertical notes-textarea"
                        rows="50"
                        placeholder="Prenez des notes ici..."
                        aria-label="Notes"
                    {{ stimulus_target('game--game-notes', 'notes') }}
                    data-action="input->game--game-notes#saveNotes resize->game--game-notes#saveTextareaHeight"
                >{{ game.notes }}</textarea>
                <div class="text-secondary small" {{ stimulus_target('game--game-notes', 'status') }}>
                    Notes sauvegardées automatiquement
                </div>
            </div>

            <button
                    type="button"
                    class="btn btn-icon btn-overlay notes-toggle-btn"
                    {{ stimulus_target('game--game-notes', 'toggle') }}
                    data-action="click->game--game-notes#togglePanel"
                    aria-label="Afficher/masquer les notes"
                    title="Afficher les notes">
                {{ ux_icon('mdi:note-text', {height: '20', width: '20'}) }}
            </button>
        </div>
    {% endif %}

    {{ component('GameFrame', {game: game}) }}
{% endblock %}
