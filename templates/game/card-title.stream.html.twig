<turbo-stream action="update" targets="#bingo-card-title">
    <template>
        <h1>
            Bingo {{ game.round }}
            {% if game.finishedAt %}
                (terminé)
            {% elseif game.startedAt %}
                (en cours)
            {% else %}
                (pas démarré)
            {% endif %}
        </h1>
        <h2>Équipe {{ game.team }}</h2>
    </template>
</turbo-stream>
