{% extends 'layouts/main.html.twig' %}

{% block content %}
    <div class="row g-4 justify-content-center">
        <div class="col-md-4 col-xl-3">
            <div class="card">
                <div class="card-body text-center py-4">
                    <span class="avatar avatar-xl avatar-rounded profile-avatar mb-3">{{ ux_icon('tabler:user', {class: 'w-6 h-6'}) }}</span>
                    <h2 class="profile-name mb-2">{{ app.user }}</h2>
                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="badge bg-red text-red-fg">{{ ux_icon('tabler:shield-star', {class: 'w-3 h-3 me-1'}) }}Administrateur</span>
                    {% elseif is_granted('ROLE_REFEREE') %}
                        <span class="badge bg-green text-green-fg">{{ ux_icon('tabler:gavel', {class: 'w-3 h-3 me-1'}) }}Arbitre</span>
                    {% endif %}
                </div>
                <div class="card-footer text-secondary small text-center">
                    {{ ux_icon('tabler:clock', {class: 'w-3 h-3 me-1'}) }}
                    {% if app.user.previousLoginAt %}
                        Connexion précédente le {{ app.user.previousLoginAt|date('d/m/Y à H:i') }}
                    {% else %}
                        Première connexion
                    {% endif %}
                </div>
            </div>

            {% if is_granted('ROLE_REFEREE') %}
                <div class="card mt-4">
                    <div class="card-header">
                        <h3 class="card-title">Accès rapides</h3>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for link in [
                            {route: 'app_referee_dashboard', icon: 'layout-dashboard', label: 'Tableau de bord'},
                            {route: 'app_referee_game', icon: 'device-gamepad-2', label: 'Parties'},
                            {route: 'app_referee_bingo', icon: 'grid-3x3', label: 'Bingos'},
                            {route: 'app_referee_team', icon: 'users-group', label: 'Équipes'},
                        ] %}
                            <a href="{{ path(link.route) }}" class="list-group-item list-group-item-action d-flex align-items-center gap-2">
                                {{ ux_icon('tabler:' ~ link.icon, {height: '18', width: '18'}) }}
                                {{ link.label }}
                                {{ ux_icon('tabler:chevron-right', {height: '16', width: '16', class: 'ms-auto text-secondary'}) }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-md-8 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <div>
                        <h3 class="card-title d-flex align-items-center gap-2">
                            {{ ux_icon('tabler:lock', {height: '18', width: '18'}) }}
                            Mot de passe
                        </h3>
                        <p class="card-subtitle mb-0">Saisissez votre mot de passe actuel puis choisissez-en un nouveau.</p>
                    </div>
                </div>
                {{ component('ChangePasswordForm') }}
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <div>
                        <h3 class="card-title d-flex align-items-center gap-2">
                            {{ ux_icon('tabler:devices', {height: '18', width: '18'}) }}
                            Sessions
                        </h3>
                        <p class="card-subtitle mb-0">Déconnecte tous les autres navigateurs connectés à ce compte. Changer le mot de passe a le même effet.</p>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <form method="post" action="{{ path('app_user_logout_other_sessions') }}">
                        {{ component('CsrfInput', {tokenId: 'logout-other-sessions'}) }}
                        <button type="submit" class="btn btn-outline-secondary">
                            {{ ux_icon('tabler:logout', {height: '18', width: '18'}) }}&nbsp;Déconnecter les autres sessions
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
