{% extends 'layouts/main.html.twig' %}

{# Override Bootstrap 5 horizontal form layout to make labels wider #}
{% form_theme form _self %}

{% block form_label_class -%}
    col-sm-12
{%- endblock form_label_class %}

{% block form_group_class -%}
    col-sm-12
{%- endblock form_group_class %}

{% block content %}
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card profile-card border-0 shadow-sm">
                <div class="profile-cover"></div>
                <div class="card-body text-center pt-0 pb-4">
                    <div class="profile-avatar">
                        <span class="avatar avatar-xl avatar-rounded">{{ ux_icon('tabler:user', {class: 'w-6 h-6'}) }}</span>
                    </div>
                    <h3 class="profile-name mt-3 mb-2">{{ user }}</h3>
                    <div class="mt-3">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="badge text-bg-danger rounded-pill">{{ ux_icon('tabler:shield-star', {class: 'w-3 h-3 me-1'}) }}Administrateur</span>
                        {% elseif 'ROLE_REFEREE' in user.roles %}
                            <span class="badge text-bg-success rounded-pill">{{ ux_icon('tabler:gavel', {class: 'w-3 h-3 me-1'}) }}Arbitre</span>
                        {% else %}
                            <span class="badge text-bg-primary rounded-pill">{{ ux_icon('tabler:user', {class: 'w-3 h-3 me-1'}) }}Joueur</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        {{ ux_icon('tabler:lock', {height: '18', width: '18'}) }}
                        Changer de mot de passe
                    </h3>
                </div>
                <div class="card-body">
                    {% for flash_error in app.flashes('error') %}
                        <div class="alert alert-danger" role="alert">
                            {{ flash_error }}
                        </div>
                    {% endfor %}

                    {% for flash_success in app.flashes('success') %}
                        <div class="alert alert-success" role="alert">
                            {{ flash_success }}
                        </div>
                    {% endfor %}

                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.currentPassword, {'attr': {'autofocus': true}}) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.plainPassword.first) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.plainPassword.second) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
