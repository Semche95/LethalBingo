{% extends 'layouts/main.html.twig' %}

{% block title %}Connexion | {{ parent() }}{% endblock %}

{% block content %}
    <div class="login-page">
        <div class="login-card">
            <div class="login-header">
                <img src="{{ asset('assets/img/logo.png') }}" alt="Logo" class="login-logo">
                <h2 class="login-title">Connexion</h2>
                <p class="login-subtitle">Accédez à votre espace Lethal Bingo</p>
            </div>

            {% if error %}
                <div class="alert alert-danger d-flex align-items-center">
                    {{ ux_icon('tabler:alert-circle', {height: '18', width: '18'}) }}
                    <span class="ms-2">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form action="{{ path('app_login') }}" method="post">
                <div class="login-field">
                    <label class="form-label" for="username">Nom d'utilisateur</label>
                    <div class="input-icon">
                        {{ ux_icon('tabler:user', {class: 'input-icon-svg'}) }}
                        <input type="text" value="{{ last_username }}" name="_username" id="username"
                               class="form-control" placeholder="Entrez votre identifiant" autocomplete="username" required autofocus>
                    </div>
                </div>

                <div class="login-field">
                    <label class="form-label" for="password">Mot de passe</label>
                    <div class="input-icon">
                        {{ ux_icon('tabler:lock', {class: 'input-icon-svg'}) }}
                        <input type="password" name="_password" id="password" class="form-control"
                               placeholder="Entrez votre mot de passe" autocomplete="current-password" required>
                    </div>
                </div>

                <label class="form-check login-remember">
                    <input type="checkbox" class="form-check-input" name="_remember_me">
                    <span class="form-check-label">Se souvenir de moi</span>
                </label>

                <button type="submit" class="btn btn-primary btn-lg login-btn w-100">
                    {{ ux_icon('tabler:login', {height: '18', width: '18'}) }}
                    Se connecter
                </button>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </form>
        </div>
    </div>
{% endblock %}
