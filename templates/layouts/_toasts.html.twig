<div class="toast-container toast-outline position-fixed p-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="toast show align-items-center toast-outline toast-outline-{{ type }}" role="alert" aria-live="assertive"
                 aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">{{ message }}</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
                <div class="toast-progress">
                    <div class="toast-progress-bar toast-progress-bar-{{ type }}"></div>
                </div>
            </div>
        {% endfor %}
    {% endfor %}
</div>
