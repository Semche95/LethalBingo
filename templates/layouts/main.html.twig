{% extends 'layouts/base.html.twig' %}

{% block body %}
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl align-items-stretch">
                <h1 class="navbar-brand d-none-navbar-horizontal pe-0 pe-md-3">
                    <a href="{{ path('app_home') }}">
                        <img src="{{ asset('assets/img/logo.png') }}" width="32" height="32" alt="Bingo Lethal Company" class="navbar-brand-image">
                    </a>
                </h1>
                <div class="navbar-nav flex-row order-md-last">
                    {% if is_granted('IS_AUTHENTICATED') %}
                        <div class="nav-item {{ app.request.attributes.get('_route') == 'app_user_profile' ? 'active' : '' }}">
                            <a href="{{ path('app_user_profile') }}" class="nav-link d-flex lh-1" title="Profil">
                                <span class="avatar avatar-sm">{{ ux_icon('tabler:user', {class: 'w-4 h-4'}) }}</span>
                                <div class="d-none d-xl-block ps-2">{{ app.user }}</div>
                            </a>
                        </div>
                        <form action="{{ path('app_logout') }}" method="post" class="nav-item">
                            {{ component('CsrfInput', {tokenId: 'logout'}) }}
                            <button type="submit" class="nav-link btn btn-link" title="Déconnexion" aria-label="Déconnexion">
                                {{ ux_icon('tabler:logout', {class: 'w-4 h-4'}) }}
                            </button>
                        </form>
                    {% else %}
                        <div class="nav-item {{ app.request.attributes.get('_route') == 'app_login' ? 'active' : '' }}">
                            <a href="{{ path('app_login') }}" class="nav-link">
                                {{ ux_icon('tabler:user', {class: 'w-4 h-4'}) }}
                                <span class="nav-link-title">Connexion</span>
                            </a>
                        </div>
                    {% endif %}
                </div>
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
                        <div class="navbar-nav">
                            <div class="nav-item {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">
                                <a class="nav-link" href="{{ path('app_home') }}">
                                    {{ ux_icon('tabler:home', {class: 'w-4 h-4'}) }}
                                    <span class="nav-link-title">Accueil</span>
                                </a>
                            </div>
                            {% if is_granted('ROLE_REFEREE') %}
                                <div class="nav-item {{ app.request.attributes.get('_route') starts with 'app_referee' ? 'active' : '' }}">
                                    <a class="nav-link" href="{{ path('app_referee_dashboard') }}">
                                        {{ ux_icon('tabler:layout-dashboard', {class: 'w-4 h-4'}) }}
                                        <span class="nav-link-title">Tableau de bord</span>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-wrapper">
            <div class="page-body">
                <div class="container-xl">
                    {% block content %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
