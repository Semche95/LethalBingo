{% extends 'layouts/base.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block body %}
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl align-items-stretch">
                <h1 class="navbar-brand d-none-navbar-horizontal pe-0 pe-md-3">
                    <a href="{{ path('app_home') }}">
                        <img src="{{ asset('assets/img/logo.png') }}" width="32" height="32" alt="Bingo Lethal Company" class="navbar-brand-image">
                    </a>
                </h1>
                <div class="navbar-nav flex-row order-md-last align-self-center">
                    {% if is_granted('IS_AUTHENTICATED') %}
                        <div class="nav-item {{ macros.active_class('app_user_profile') }}">
                            <a href="{{ path('app_user_profile') }}" class="nav-link d-flex lh-1" title="Profil">
                                <span class="avatar avatar-sm">{{ ux_icon('tabler:user', {class: 'w-4 h-4'}) }}</span>
                                <div class="d-none d-xl-block ps-2">{{ app.user }}</div>
                            </a>
                        </div>
                        <twig:PostForm :action="path('app_logout')" :tokenId="'logout'" class="nav-item">
                            <button type="submit" class="nav-link btn btn-link" title="Déconnexion" aria-label="Déconnexion">
                                {{ ux_icon('tabler:logout', {class: 'w-4 h-4'}) }}
                            </button>
                        </twig:PostForm>
                    {% else %}
                        <twig:NavbarItem route="app_login" label="Connexion" icon="user" />
                    {% endif %}
                </div>
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
                        <div class="navbar-nav">
                            <twig:NavbarItem route="app_home" label="Accueil" icon="home" />
                            {% if is_granted('ROLE_REFEREE') %}
                                <twig:NavbarItem route="app_referee_dashboard" label="Tableau de bord" icon="layout-dashboard" activePrefix="app_referee" />
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-wrapper">
            <div class="page-body">
                <div class="container-xl">
                    {% block content %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
