{% extends 'layouts/main.html.twig' %}

{% block title %}Tableau de bord | {{ parent() }}{% endblock %}

{% block content %}
    <div class="modal modal-blur fade" id="add-team-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nouvelle équipe</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <nav class="referee-tabs mb-4">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link{% if app.request.attributes.get('_route') starts with 'app_referee_dashboard' %} active{% endif %}" href="{{ path('app_referee_dashboard') }}">Tableau de bord</a>
            </li>
            <li class="nav-item">
                <a class="nav-link{% if app.request.attributes.get('_route') starts with 'app_referee_game' %} active{% endif %}" href="{{ path('app_referee_game') }}">Parties</a>
            </li>
            <li class="nav-item">
                <a class="nav-link{% if app.request.attributes.get('_route') starts with 'app_referee_bingo' %} active{% endif %}" href="{{ path('app_referee_bingo') }}">Bingos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link{% if app.request.attributes.get('_route') starts with 'app_referee_team' %} active{% endif %}" href="{{ path('app_referee_team') }}">Équipes</a>
            </li>
        </ul>
    </nav>
{% endblock %}
