{% extends 'layouts/main.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block title %}Tableau de bord | {{ parent() }}{% endblock %}

{% block content %}
    {% component BootstrapModal with {id: 'add-team-modal'} %}
        {% block modal_classes %}modal-lg{% endblock %}
        {% block modal_title %}Nouvelle équipe{% endblock %}
    {% endcomponent %}

    <nav class="referee-tabs mb-4">
        <ul class="nav nav-pills">
            {% for tab in referee_sections %}
                <li class="nav-item">
                    <a class="nav-link {{ macros.active_class(tab.route, true) }}" href="{{ path(tab.route) }}">{{ tab.label }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endblock %}
