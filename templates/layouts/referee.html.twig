{% extends 'layouts/main.html.twig' %}

{% block title %}Tableau de bord | {{ parent() }}{% endblock %}

{% block content %}
    <header class="navbar navbar-expand-md d-print-none mb-4">
        <div class="container-xl p-0">
            <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
                <ul class="navbar-nav">
                    <li class="nav-item px-2{% if app.request.attributes.get('_route') starts with 'app_referee_dashboard' %} active{% endif %}">
                        <a class="nav-link" href="{{ path('app_referee_dashboard') }}">
                            <span class="nav-link-title">Tableau de bord</span>
                        </a>
                    </li>
                    <li class="nav-item px-2{% if app.request.attributes.get('_route') starts with 'app_referee_game' %} active{% endif %}">
                        <a class="nav-link" href="{{ path('app_referee_game') }}">
                            <span class="nav-link-title">Parties</span>
                        </a>
                    </li>
                    <li class="nav-item px-2{% if app.request.attributes.get('_route') starts with 'app_referee_bingo' %} active{% endif %}">
                        <a class="nav-link" href="{{ path('app_referee_bingo') }}">
                            <span class="nav-link-title">Bingos</span>
                        </a>
                    </li>
                    <li class="nav-item px-2{% if app.request.attributes.get('_route') starts with 'app_referee_team' %} active{% endif %}">
                        <a class="nav-link" href="{{ path('app_referee_team') }}">
                            <span class="nav-link-title">Équipes</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>
{% endblock %}
