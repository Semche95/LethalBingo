{# Page title with optional content next to it (badge, button), a subtitle below and actions on the right. #}
{% props title, subtitle = null, spacing = 4 %}

<div{{ attributes.defaults({class: 'd-flex justify-content-between align-items-center gap-3 mb-' ~ spacing}) }}>
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="dashboard-title mb-0">{{ title }}</h1>
            {% block after_title %}{% endblock %}
        </div>
        {% if subtitle or block('subtitle') %}
            <p class="dashboard-subtitle">{% block subtitle %}{{ subtitle }}{% endblock %}</p>
        {% endif %}
    </div>
    {% if block('actions') %}
        <div class="d-flex align-items-center gap-3">
            {% block actions %}{% endblock %}
        </div>
    {% endif %}
</div>
