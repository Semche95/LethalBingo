{# Layout of the timer block: title above, value always centered with the icon beside it, then the actions on the right. #}
{% props title %}
<div class="timer-panel">
    <div class="timer-main">
        <h3 class="hud-label hud-label-blue timer-label">{{ title }}</h3>
        <div class="timer-readout">
            {{ ux_icon('tabler:stopwatch', {class: 'timer-icon'}) }}
            <div {{ attributes.defaults({class: 'timer-value'}) }}>
                {%- block value %}{% endblock -%}
            </div>
        </div>
        <div class="timer-below">
            {% block below %}{% endblock %}
        </div>
    </div>
    {% block actions %}{% endblock %}
</div>
