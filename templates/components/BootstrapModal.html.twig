<div {{ attributes.defaults({
    class: 'modal modal-blur fade',
    tabindex: '-1',
    'aria-hidden': 'true',
    id: id ? id : false,
}|merge(stimulus_controller('bootstrap-modal').toArray())) }}>
    <div class="modal-dialog {% block modal_classes %}{% endblock %}">
        {% block modal_full_content %}
            <div class="modal-content">
                {% if status is not null %}
                    <div class="modal-status bg-{{ status }}"></div>
                {% endif %}
                <div class="modal-header">
                    {% if block('modal_title') %}
                        <h5 class="modal-title">{% block modal_title %}{% endblock %}</h5>
                    {% endif %}
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    {% block modal_body %}{% endblock %}
                </div>

                {% if block('modal_footer') %}
                    <div class="modal-footer">
                        {% block modal_footer %}{% endblock %}
                    </div>
                {% endif %}
            </div>
        {% endblock %}
    </div>
</div>
