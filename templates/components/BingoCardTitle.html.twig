<div{{ attributes.defaults({class: 'game-title'}) }}>
    <h1>Bingo {{ this.game.round }}</h1>
    {# Team and status on the same line, to keep the title short #}
    <div class="game-title-meta">
        <h2>Équipe {{ this.game.team }}</h2>
        {% set live = this.game.started and not this.game.finished %}
        <span class="game-status-chip{{ live ? ' is-live' }}">
            <span class="status-dot {{ live ? 'status-dot-animated status-green' : 'status-secondary' }}"></span>
            {% if this.game.finished %}
                Terminée
            {% elseif live %}
                En cours
            {% else %}
                Non démarrée
            {% endif %}
        </span>
    </div>
</div>
