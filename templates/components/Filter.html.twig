<div {{ attributes.defaults({class: 'px-3 py-2 border-bottom'}) }}>
    <div class="d-flex align-items-center flex-wrap flex-md-nowrap gap-3">
        <div class="d-flex align-items-center">
            <span class="text-body-secondary me-3">{{ ux_icon('tabler:filter', {height: '18', width: '18'}) }} Filtres&nbsp;:</span>
        </div>
        <div class="d-flex align-items-center">
            <label for="filter-round" class="form-label mb-0 me-2 text-nowrap">Round</label>
            <select
                    id="filter-round"
                    class="form-select"
                    data-model="round"
            >
                <option value="">Tous</option>
                {% for roundNumber in this.rounds %}
                    <option value="{{ roundNumber }}" {% if this.round == roundNumber %}selected{% endif %}>
                        {{ roundNumber }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="d-flex align-items-center">
            <label for="filter-season" class="form-label mb-0 me-2 text-nowrap">Saison</label>
            <select
                    id="filter-season"
                    class="form-select"
                    data-model="season"
            >
                <option value="">Toutes</option>
                {% for seasonNumber in this.seasons %}
                    <option value="{{ seasonNumber }}" {% if this.season == seasonNumber %}selected{% endif %}>
                        {{ seasonNumber }}
                    </option>
                {% endfor %}
            </select>
        </div>
        {% if this.context == 'game' %}
            <div class="d-flex align-items-center">
                <label for="filter-team" class="form-label mb-0 me-2 text-nowrap">Équipe</label>
                <select
                        id="filter-team"
                        class="form-select"
                        data-model="team"
                >
                    <option value="">Toutes</option>
                    {% for team in this.teams %}
                        <option value="{{ team.id }}" {% if this.team == team.id %}selected{% endif %}>
                            {{ team.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="d-flex align-items-center">
                <label for="filter-started" class="form-label mb-0 me-2 text-nowrap">Démarrée</label>
                <select
                        id="filter-started"
                        class="form-select"
                        data-model="started"
                >
                    <option value="null">Tous</option>
                    <option value="true" {% if this.started == true %}selected{% endif %}>Oui</option>
                    <option value="false" {% if this.started == false %}selected{% endif %}>Non</option>
                </select>
            </div>
            <div class="d-flex align-items-center">
                <label for="filter-ended" class="form-label mb-0 me-2 text-nowrap">Terminée</label>
                <select
                        id="filter-ended"
                        class="form-select"
                        data-model="ended"
                >
                    <option value="null">Tous</option>
                    <option value="true" {% if this.ended == true %}selected{% endif %}>Oui</option>
                    <option value="false" {% if this.ended == false %}selected{% endif %}>Non</option>
                </select>
            </div>
        {% endif %}
        <div class="d-flex align-items-center">
            <button
                    type="button"
                    class="btn btn-outline-secondary"
                    data-controller="component--filter-reset"
                    data-action="click->component--filter-reset#reset"
            >
                {{ ux_icon('tabler:filter-off', {height: '18', width: '18'}) }}
                Réinitialiser
            </button>
        </div>
    </div>
</div>
