<div {{ attributes.defaults({class: 'table-responsive'}) }}>
    <table class="{{ table_classes }}">
        {% if columns is not empty and (show_header is not defined or show_header) %}
            <thead>
            <tr>
                {% for column in columns %}
                    <th>{{ column }}</th>
                {% endfor %}
            </tr>
            </thead>
        {% elseif block('table_head') %}
            {% block table_head %}{% endblock %}
        {% endif %}

        {% if not block('table_body') %}
            <tbody>
            {% for row in data %}
                <tr>
                    {% for index, cell in row %}
                        {% set class = options[index].class|default('') %}
                        <td{% if class|length > 0 %} class="{{ class }}"{% endif %}>
                            {{ cell }}
                        </td>
                    {% endfor %}
                </tr>
            {% else %}
                {% if empty_data is not empty %}
                    <tr>
                        <td colspan="{{ columns|default([])|length }}">
                            {{ empty_data }}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        {% else %}
            {% block table_body %}{% endblock %}
        {% endif %}

        {% if block('table_foot') %}
            <tfoot>
            {% block table_foot %}{% endblock %}
            </tfoot>
        {% endif %}
    </table>
</div>
