{% props route, label, icon, activePrefix = false %}
{% import 'macros.html.twig' as macros %}

<div{{ attributes.defaults({class: 'nav-item ' ~ macros.active_class(activePrefix ?: route, activePrefix is not same as(false))}) }}>
    <a class="nav-link" href="{{ path(route) }}">
        {{ ux_icon('tabler:' ~ icon, {class: 'w-4 h-4'}) }}
        <span class="nav-link-title">{{ label }}</span>
    </a>
</div>
