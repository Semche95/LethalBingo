<div {{ attributes.defaults(stimulus_controller('referee--team-form')) }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    {% if modalMode %}
        <input type="hidden" name="modalMode" value="1">
    {% endif %}
    {{ form_errors(form) }}
    <div class="card-body">
        <div class="mb-3">
            {{ form_label(form.name, 'Nom de l\'équipe', {label_attr: {class: 'form-label text-nowrap'}}) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="form-label mb-0">Membres</span>
            {{ form_widget(form.members.vars.button_add, {
                label: ux_icon('tabler:plus', {height: '18', width: '18'})~'&nbsp;Nouveau membre',
                label_html: true,
                attr: {
                    class: 'btn-outline-primary',
                    'data-action': 'live#action',
                    'data-live-action-param': 'addCollectionItem',
                    'data-live-arg-name-param': 'members'
                }
            }) }}
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 member-table">
                <tbody>
                {% for member_form in form.members %}
                    <tr>
                        <td>
                            {{ form_widget(member_form.name) }}
                            {{ form_errors(member_form.name) }}
                        </td>
                        <td class="align-middle td-shrink px-3">
                            <div class="d-none">
                                {{ form_widget(member_form.captain, {attr: {'data-referee--team-form-target': 'checkbox'}}) }}
                            </div>
                            <button type="button"
                                    class="btn-captain {% if member_form.captain.vars.data %}btn-captain-active{% endif %}"
                                    data-referee--team-form-target="button"
                                    data-action="click->referee--team-form#selectCaptain"
                                    title="{% if not member_form.captain.vars.data %}Faire de ce membre le capitaine{% endif %}"
                                    aria-label="{% if not member_form.captain.vars.data %}Faire de ce membre le capitaine{% endif %}">
                                {{ ux_icon('tabler:crown', {height: '18', width: '18'}) }}
                            </button>
                        </td>
                        <td class="align-middle text-end td-shrink">
                            {{ form_widget(member_form.vars.button_delete, {
                                label: ux_icon('tabler:trash', {height: '18', width: '18'}),
                                label_html: true,
                                attr: {
                                    class: 'btn-ghost-danger'
                                }
                            }) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-body-secondary text-center">Aucun membre pour l'instant.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2 align-items-center">
                {% if modalMode %}
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                {% else %}
                    <a href="{{ path('app_referee_team') }}" class="btn btn-outline-secondary">Retour</a>
                {% endif %}
                {% if mode == 'edit' %}
                    <span class="text-muted mx-1">|</span>
                    <button type="button" class="btn btn-outline-danger" data-action="click->referee--team-form#openDeleteModal">
                        {{ ux_icon('tabler:trash', {height: '18', width: '18'}) }}&nbsp;Supprimer
                    </button>
                {% endif %}
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
    </div>
    {{ form_end(form) }}

    {% if mode == 'edit' %}
        {% component BootstrapModal with {id: 'delete-team-modal', status: 'danger'} %}
            {% block modal_title %}Confirmation de la suppression{% endblock %}
            {% block modal_body %}
                Supprimer l'équipe <strong>{{ team }}</strong>&nbsp;?
            {% endblock %}
            {% block modal_footer %}
                <form action="{{ path('app_referee_team_delete', {id: team.id}) }}" method="post" class="d-flex w-100">
                    {{ component('CsrfInput', {tokenId: 'delete-team'}) }}
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger ms-auto">
                        {{ ux_icon('tabler:trash', {height: '18', width: '18'}) }}&nbsp;Supprimer
                    </button>
                </form>
            {% endblock %}
        {% endcomponent %}
    {% endif %}
</div>
