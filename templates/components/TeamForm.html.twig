<div {{ attributes.defaults(stimulus_controller('referee--team-form')) }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    {{ form_errors(form) }}
    <div class="card-body">
        <div class="row mb-3">
            {{ form_label(form.name) }}
            <div class="col-sm-4">
                {{ form_widget(form.name) }}
            </div>
            <div class="offset-sm-2 col-sm-10">
                {{ form_errors(form.name) }}
            </div>
        </div>
        <div class="row row-cards">
            <div class="col-md">
                <div class="card">
                    <div class="card-status-top bg-blue"></div>
                    <div class="card-header">
                        <h3 class="card-title">Membres</h3>
                        <div class="card-actions">
                            {{ form_widget(form.members.vars.button_add, {
                                label: ux_icon('tabler:plus', {height: '18', width: '18'})~'&nbsp;Nouveau membre',
                                label_html: true,
                                attr: {
                                    class: 'btn-primary',
                                    'data-action': 'live#action',
                                    'data-live-action-param': 'addCollectionItem',
                                    'data-live-arg-name-param': 'members'
                                }
                            }) }}
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <tbody>
                                {% for member_form in form.members %}
                                    <tr>
                                        <td>
                                            {{ form_widget(member_form.name) }}
                                            {{ form_errors(member_form.name) }}
                                        </td>
                                        <td class="align-middle">
                                            {{ form_widget(member_form.captain, {attr: {}
                                                |merge(stimulus_target('referee--team-form', 'captain').toArray())
                                                |merge(stimulus_action('referee--team-form', 'selectCaptain').toArray())
                                            }) }}
                                        </td>
                                        <td class="text-end">
                                            {{ form_widget(member_form.vars.button_delete, {
                                                label: ux_icon('tabler:trash', {height: '18', width: '18'}),
                                                label_html: true,
                                                attr: {
                                                    class: 'btn-danger',
                                                    'data-action': 'live#action',
                                                    'data-live-action-param': 'removeCollectionItem',
                                                    'data-live-arg-name-param': 'members',
                                                    'data-live-arg-index-param': member_form.vars.name|replace({'members[': '', ']': ''})
                                                }
                                            }) }}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3">Aucun membre</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="d-flex">
            <a href="{{ path('app_referee_team') }}" class="btn btn-secondary">Retour</a>
            {% if mode == 'edit' %}
                <div class="vr mx-3"></div>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#delete-team-modal">
                    {{ ux_icon('tabler:trash', {height: '18', width: '18'}) }}&nbsp;Supprimer
                </button>
            {% endif %}
            <button type="submit" class="btn btn-success ms-auto">Enregistrer</button>
        </div>
    </div>
    {{ form_end(form) }}

    {% if mode == 'edit' %}
        {% component BootstrapModal with {id: 'delete-team-modal', status: 'danger'} %}
            {% block modal_title %}Confirmation de la suppression{% endblock %}
            {% block modal_body %}
                Supprimer l'équipe <strong>{{ team }}</strong>&nbsp;?
            {% endblock %}
            {% block modal_footer %}
                <form action="{{ path('app_referee_team_delete', {id: team.id}) }}" method="post" class="d-flex w-100">
                    <input type="hidden" name="token" value="{{ csrf_token('delete-team') }}">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger ms-auto">
                        {{ ux_icon('tabler:trash', {height: '18', width: '18'}) }}&nbsp;Supprimer
                    </button>
                </form>
            {% endblock %}
        {% endcomponent %}
    {% endif %}
</div>
