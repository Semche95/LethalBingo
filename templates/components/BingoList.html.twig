<div {{ attributes }}>
    <div class="d-flex align-items-center gap-2 mb-5">
        <h1 class="dashboard-title mb-0">Bingos</h1>
        <form method="post" action="{{ path('app_referee_bingo_add_season') }}">
            <input type="hidden" name="token" value="{{ csrf_token('add-season') }}">
            <button type="submit" class="btn btn-outline-primary px-2">
                {{ ux_icon('tabler:plus', {height: '18', width: '18'}) }} Nouvelle saison
            </button>
        </form>
    </div>

    {% if this.bingosBySeason is empty %}
        <p class="text-secondary">Aucun bingo créé</p>
    {% else %}
        {% for row in this.bingosBySeason %}
            {% set rounds = row.rounds|json_decode %}
            {% set season = row.season %}
            {% set numbers = rounds|column('number') %}
            {% set counts = numbers|reduce((carry, n) => carry|merge({(n): (carry[n] ?? 0) + 1}), {}) %}
            {% set duplicateNumbers = counts|filter((c) => c > 1)|keys %}
            {% set maxNum = numbers|reduce((carry, n) => carry > n ? carry : n) %}
            {% set gaps = [] %}
            {% for i in 1..maxNum %}
                {% if i not in numbers %}
                    {% set gaps = gaps|merge([i]) %}
                {% endif %}
            {% endfor %}
            {% if gaps|length == 1 %}
                {% set gapLabel = 'Le round ' ~ gaps|join(', ') ~ ' est manquant' %}
            {% elseif gaps|length > 1 %}
                {% set gapLabel = 'Les rounds ' ~ gaps|join(', ') ~ ' sont manquants' %}
            {% endif %}
            <div class="{% if not loop.first %}mt-4{% endif %}">
                <div class="season-accent season-accent-{{ loop.index0 % 6 + 1 }}">
                    <div class="d-flex align-items-center mb-2 gap-2">
                        <h3 class="card-title mb-2">Saison {{ season }}</h3>
                        <span class="badge season-count-badge">{{ rounds|length }} rounds</span>
                        <form method="post" action="{{ path('app_referee_bingo_add_round', {season: season}) }}">
                            <input type="hidden" name="token" value="{{ csrf_token('add-round-' ~ season) }}">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                {{ ux_icon('tabler:plus', {height: '14', width: '14'}) }}&nbsp;Nouveau round
                            </button>
                        </form>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-2">
                        {% for bingo in rounds %}
                            {% set comp = this.completenessIndex[bingo.id] ?? null %}
                            {% set isDuplicate = bingo.number in duplicateNumbers %}
                            {% set isIncomplete = (comp ? comp.square_count : 0) < constant('App\\Entity\\GameRound::EXPECTED_SQUARES') or (comp ? comp.incomplete_content : false) %}
                            {% set tooltipParts = [] %}
                            {% if isDuplicate %}
                                {% set tooltipParts = tooltipParts|merge(['Doublon détecté, modifiez le numéro de round sur la fiche pour corriger']) %}
                            {% endif %}
                            {% if isIncomplete %}
                                {% set tooltipParts = tooltipParts|merge(['Bingo incomplet']) %}
                            {% endif %}
                            <a href="{{ path('app_referee_bingo_edit', {id: bingo.id}) }}"
                               class="round-pill{% if isDuplicate %} round-pill--duplicate{% endif %}{% if isIncomplete %} round-pill--incomplete{% endif %}"
                               {% if tooltipParts|length > 0 %}data-bs-toggle="tooltip" title="{{ tooltipParts|join(' — ') }}"{% endif %}>
                                Round {{ bingo.number }}
                                {{ ux_icon('tabler:pencil', {height: '16', width: '16'}) }}
                                {% if isIncomplete or isDuplicate %}
                                    {{ ux_icon('tabler:alert-triangle', {height: '14', width: '14'}) }}
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>

                    {% if gaps is not empty %}
                        <div class="alert alert-warning py-2 px-3 mb-0 d-flex align-items-center gap-2">
                            <span>{{ gapLabel }}.</span>
                            <form method="post"
                                  action="{{ path('app_referee_bingo_fill_gaps', {season: season}) }}"
                                  class="d-inline">
                                <input type="hidden" name="token"
                                       value="{{ csrf_token('fill-gaps-' ~ season) }}">
                                <button type="submit" class="btn btn-sm btn-warning">
                                    Combler
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}

    {% endif %}
</div>
