<div {{ attributes }}>
    <div class="d-flex align-items-center gap-2 mb-5">
        <h1 class="dashboard-title mb-0">Bingos</h1>
        <a href="{{ path('app_referee_bingo_add_season') }}" class="btn btn-outline-primary px-2">
            {{ ux_icon('tabler:plus', {height: '18', width: '18'}) }} Nouvelle saison
        </a>
    </div>

    {% if this.bingosBySeason is empty %}
        <p class="text-secondary">Aucun bingo créé</p>
    {% else %}
        {% for row in this.bingosBySeason %}
            {% set rounds = row.rounds|json_decode %}
            {% set season = row.season %}
            <div class="{% if not loop.first %}mt-4{% endif %}">
                <div class="season-accent season-accent-{{ loop.index0 % 6 + 1 }}">
                    <div class="d-flex align-items-center mb-2 gap-2">
                        <h3 class="card-title mb-2">Saison {{ season }}</h3>
                        <span class="badge season-count-badge">{{ rounds|length }} rounds</span>
                        <a href="{{ path('app_referee_bingo_add_round', {season: season}) }}"
                           class="btn btn-sm btn-outline-primary">
                            {{ ux_icon('tabler:plus', {height: '14', width: '14'}) }}&nbsp;Nouveau round
                        </a>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-2">
                        {% for bingo in rounds %}
                            {% set isDuplicate = bingo.number in (this.duplicatesBySeason[season] ?? []) %}
                            <a href="{{ path('app_referee_bingo_edit', {id: bingo.id}) }}"
                               class="round-pill{% if isDuplicate %} round-pill--duplicate{% endif %}"
                               {% if isDuplicate %}data-bs-toggle="tooltip" title="Doublon détecté, modifiez le numéro de round sur la fiche pour corriger"{% endif %}>
                                Round {{ bingo.number }}
                                {{ ux_icon('tabler:pencil', {height: '16', width: '16'}) }}
                                {% if isDuplicate %}
                                    {{ ux_icon('tabler:alert-triangle', {height: '14', width: '14'}) }}
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>

                    {% if this.gapsBySeason[season] is defined and this.gapsBySeason[season] is not empty %}
                        <div class="alert alert-warning py-2 px-3 mb-0 d-flex align-items-center gap-2">
                            <span>{{ this.gapLabelsBySeason[season] }}.</span>
                            <form method="post"
                                  action="{{ path('app_referee_bingo_fill_gaps', {season: season}) }}"
                                  class="d-inline">
                                <input type="hidden" name="token"
                                       value="{{ csrf_token('fill-gaps-' ~ season) }}">
                                <button type="submit" class="btn btn-sm btn-warning">
                                    Combler
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}

    {% endif %}
</div>
