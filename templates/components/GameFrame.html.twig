{% import 'macros.html.twig' as macros %}
<div {{ attributes.defaults(stimulus_controller('game--game-frame', {
    mercureUrl: mercure('game/' ~ this.game.slug)
})) }}>
    <div class="page">
        <div class="container game-container my-auto">
            <div class="game-stack">
                {{ component('BingoCardTitle', {game: this.game}) }}

                {% set stopwatchDurationSeconds = computed.stopwatchDurationSeconds %}
                {% if not this.game.finished or stopwatchDurationSeconds is not null %}
                    <div class="card">
                        <div class="card-body timer-card">
                            {% if not this.game.finished %}
                                {{ component('GameTimer', {game: this.game}) }}
                            {% else %}
                                {% set stopwatchDuration = macros.elapsed(stopwatchDurationSeconds) %}
                                <twig:TimerPanel title="Durée de la partie">
                                    <twig:block name="value">{{ stopwatchDuration }}</twig:block>
                                </twig:TimerPanel>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if is_granted('ROLE_REFEREE') %}
                    <div class="card">
                        <div class="card-body game-footer">
                            {% if this.game.started %}
                                {% set footerDate = this.game.finished ? this.game.finishedAt : this.game.startedAt %}
                                <span class="game-footer-date">
                                    {{ ux_icon('tabler:clock') }}
                                    Partie {{ this.game.finished ? 'terminée' : 'démarrée' }} le
                                    <span class="hud-num">{{ footerDate|date('d/m/Y') }}</span> à
                                    <span class="hud-num">{{ footerDate|date('H:i:s') }}</span>
                                </span>
                            {% endif %}
                            <div class="game-footer-actions">
                                <a href="{{ path('app_referee_game_edit', {id: this.game.id}) }}"
                                   class="btn btn-outline-secondary game-footer-back">
                                    {{ ux_icon('tabler:arrow-left') }}
                                    Retour au tableau de bord
                                </a>
                                {% if not this.game.started %}
                                    {# Only a warning: the referee can still start from the modal #}
                                    <button
                                            type="button"
                                            class="btn btn-primary game-footer-main"
                                            {% if computed.previousRoundStatus %}
                                                data-bs-toggle="modal"
                                                data-bs-target="#start-game-modal"
                                            {% else %}
                                                data-action="live#action"
                                                data-live-action-param="startGame"
                                            {% endif %}
                                    >
                                        Démarrer la partie
                                    </button>
                                {% else %}
                                    {% if this.game.finished %}
                                        {# Wrapped: Live never removes an element with data-live-ignore, but removes its parent on reset #}
                                        <div class="game-footer-main game-footer-results">
                                            <twig:GameHighlights :game="this.game" />
                                            {% if this.game.round.rules is not empty %}
                                                {# Main action once the game is over: count the points #}
                                                <button type="button" class="btn btn-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#game-points-modal">
                                                    {{ ux_icon('mdi:calculator', {height: '20', width: '20'}) }}
                                                    Points
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <button
                                                type="button"
                                                class="btn btn-primary game-footer-main"
                                                data-bs-toggle="modal"
                                                data-bs-target="#stop-game-modal"
                                        >
                                            Arrêter la partie
                                        </button>
                                    {% endif %}
                                    <button type="button" class="btn btn-outline-danger game-footer-reset" data-bs-toggle="modal"
                                            data-bs-target="#reset-game-modal">
                                        {{ ux_icon('tabler:restore') }}
                                        Réinitialiser
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="card">
                    <div class="card-body bingo-frame">
                        {{ component('BingoCard', {
                            'editMode': false,
                            'game': this.game,
                        }) }}
                    </div>
                </div>

                {% if is_granted('ROLE_REFEREE') and not this.game.finished %}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="hud-label hud-label-blue m-0">Étapes</h3>
                        </div>
                        <div class="card-body">
                            {{ component('GameSteps', {game: this.game}) }}
                        </div>
                    </div>
                {% endif %}

                {% set rules = this.game.round.rules %}
                {% if rules is not empty %}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="hud-label hud-label-blue m-0">Règles</h3>
                        </div>
                        <div class="card-body">
                            <ul class="game-rules">
                                {% for rule in rules %}
                                    <li>
                                        <span>{{ rule.label }}</span>
                                        <span class="rules-coefficient-cell">{{ macros.coefficient(rule.coefficient) }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% if is_granted('ROLE_REFEREE') %}
        <twig:GameHistory :game="this.game" />

        {% if this.game.finished and this.game.round.rules is not empty %}
            {% set game = this.game %}
            {% component BootstrapModal with {id: 'game-points-modal', class: 'game-points-modal', 'data-action': 'points:saved->game--game-frame#onPointsSaved'} %}
                {% block modal_classes %}modal-lg modal-dialog-centered{% endblock %}
                {% block modal_title %}Points{% endblock %}
                {% block modal_body %}<twig:GamePoints :game="game" />{% endblock %}
            {% endcomponent %}
        {% endif %}

        {% set previousRoundStatus = computed.previousRoundStatus %}
        {% if previousRoundStatus %}
            {% set previousRoundReasons = {
                no_game: 'aucune partie n\'a été créée pour ce round',
                not_started: 'sa partie n\'a pas encore été démarrée',
                in_progress: 'sa partie est encore en cours',
            } %}
            {% set game = this.game %}
            {% component ConfirmModal with {
                id: 'start-game-modal',
                title: 'Round précédent non terminé',
                confirmLabel: 'Démarrer la partie',
                confirmIcon: 'player-play',
                status: 'primary',
                liveAction: 'startGame',
            } %}
                {% block content %}
                    L'équipe <strong>{{ game.team.name }}</strong> n'a pas terminé le round
                    <span class="hud-num">{{ game.round.number - 1 }}</span>&nbsp;:
                    {{ previousRoundReasons[previousRoundStatus.value] }}. Démarrer la partie quand même&nbsp;?
                {% endblock %}
            {% endcomponent %}
        {% endif %}

        {% component ConfirmModal with {
            id: 'reset-game-modal',
            title: 'Confirmation de la réinitialisation',
            confirmLabel: 'Réinitialiser',
            confirmIcon: 'restore',
            liveAction: 'resetGame',
        } %}
            {% block content %}
                Réinitialiser la partie&nbsp;? Cette action est irréversible, toutes les cases retrouveront leur état initial
                et la partie sera considérée comme n'ayant jamais été jouée.
            {% endblock %}
        {% endcomponent %}

        {% component ConfirmModal with {
            id: 'stop-game-modal',
            title: "Confirmation de l'arrêt de la partie",
            confirmLabel: 'Arrêter la partie',
            confirmIcon: 'player-stop',
            status: 'primary',
            liveAction: 'stopGame',
        } %}
            {% block content %}
                Arrêter la partie&nbsp;? Cette action terminera la partie en cours.
            {% endblock %}
        {% endcomponent %}
    {% endif %}
</div>
