{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-model': 'on(change)|*',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    <div class="card-body vstack gap-3">
        {{ form_row(form.currentPassword, {attr: {autofocus: true}, row_attr: {class: 'mb-0'}}) }}
        <hr class="my-1">
        {{ form_row(form.plainPassword.first, {help: 'Au moins 6 caractères.', row_attr: {class: 'mb-0'}}) }}
        {{ form_row(form.plainPassword.second, {row_attr: {class: 'mb-0'}}) }}
    </div>
    <div class="card-footer d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            {{ ux_icon('tabler:device-floppy', {height: '18', width: '18'}) }}&nbsp;Changer le mot de passe
        </button>
    </div>
    {{ form_end(form) }}
</div>
