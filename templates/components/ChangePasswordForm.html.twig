{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-model': 'on(change)|*',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    <div class="card-body vstack gap-3">
        {{ form_row(form.currentPassword, {attr: {autofocus: true, class: 'w-75'}, row_attr: {class: 'mb-0'}}) }}
        <hr class="my-1">
        {# Checked as the user types: the list below stands for the errors of the
           rules, so only the other errors (empty, mismatch) are shown under the field #}
        {% set criteria = this.newPasswordCriteria %}
        {% set criteriaLabels = criteria|map(criterion => criterion.label) %}
        {{ form_row(form.plainPassword.first, {
            attr: {class: 'w-75', 'data-model': 'debounce(300)|' ~ form.plainPassword.first.vars.full_name},
            row_attr: {class: 'mb-0'},
        }|merge(isValidated
            ? {errors: form.plainPassword.first.vars.errors|filter(error => error.message not in criteriaLabels)}
            : {valid: true, errors: []})) }}
        <ul class="list-unstyled small mb-0 vstack gap-1">
            {% for criterion in criteria %}
                <li class="d-flex align-items-center gap-2 {{ criterion.met ? 'text-success' : (isValidated ? 'text-danger' : 'text-secondary') }}">
                    {{ ux_icon(criterion.met ? 'tabler:circle-check' : 'tabler:circle', {height: '16', width: '16', class: 'flex-shrink-0'}) }}
                    {{ criterion.label }}
                </li>
            {% endfor %}
        </ul>
        {{ form_row(form.plainPassword.second, {attr: {class: 'w-75'}, row_attr: {class: 'mb-0'}}) }}
    </div>
    <div class="card-footer d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            {{ ux_icon('tabler:device-floppy', {height: '18', width: '18'}) }}&nbsp;Changer le mot de passe
        </button>
    </div>
    {{ form_end(form) }}
</div>
