{% form_theme form 'bootstrap_5_layout.html.twig' %}

<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-model': 'on(change)|*',
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save'
        }
    }) }}
    <div class="card-body vstack gap-3">
        {{ form_row(form.currentPassword, {attr: {autofocus: true}, row_attr: {class: 'mb-0'}}) }}
        <hr class="my-1">
        {# Checked as the user types: until the form is submitted, the list below
           stands for the errors of this field #}
        {{ form_row(form.plainPassword.first, {
            attr: {'data-model': 'debounce(300)|' ~ form.plainPassword.first.vars.full_name},
            row_attr: {class: 'mb-0'},
        }|merge(isValidated ? {} : {valid: true, errors: []})) }}
        <ul class="list-unstyled small mb-0 vstack gap-1">
            {% for criterion in this.newPasswordCriteria %}
                <li class="d-flex align-items-center gap-2 {{ criterion.met ? 'text-success' : 'text-secondary' }}">
                    {{ ux_icon(criterion.met ? 'tabler:circle-check' : 'tabler:circle', {height: '16', width: '16'}) }}
                    {{ criterion.label }}
                </li>
            {% endfor %}
        </ul>
        {{ form_row(form.plainPassword.second, {row_attr: {class: 'mb-0'}}) }}
    </div>
    <div class="card-footer d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            {{ ux_icon('tabler:device-floppy', {height: '18', width: '18'}) }}&nbsp;Changer le mot de passe
        </button>
    </div>
    {{ form_end(form) }}
</div>
