<div {{ attributes }}
     data-action="team:added@document->live#action team:updated@document->live#action"
     data-live-action-param="loadTeams">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="dashboard-title">Équipes</h1>
        <div class="d-flex align-items-center gap-3">
            <div class="team-search input-icon">
                {{ ux_icon('tabler:search', {class: 'input-icon-svg'}) }}
                <input
                    type="search"
                    class="form-control"
                    placeholder="Rechercher une équipe ou un membre"
                    title="Rechercher une équipe ou un membre"
                    data-model="on(input)|search"
                    data-live-debounce="300"
                >
            </div>
            <a href="{{ path('app_referee_team_add') }}" class="btn btn-primary flex-shrink-0"
               data-controller="modal-loader"
               data-action="click->modal-loader#open"
               data-modal-loader-title-value="Nouvelle équipe">
                {{ ux_icon('tabler:plus', {height: '18', width: '18'}) }}&nbsp;Nouvelle équipe
            </a>
        </div>
    </div>

    {% if this.teams is empty %}
        {% if this.search is not empty %}
            <p class="text-center text-body-secondary py-5">Aucune équipe ne correspond à votre recherche.</p>
        {% else %}
            <p class="text-center text-body-secondary py-5">Aucune équipe pour le moment.</p>
        {% endif %}
    {% else %}
        <div class="team-grid">
            {% for team in this.teams %}
                {% set members = team.members|json_decode %}
                <div class="team-card" style="border-top: 3px solid {{ team_color(team.id) }};">
                    <div class="team-card-header">
                        <span class="team-card-name">{{ team.name }}</span>
                        <a href="{{ path('app_referee_team_edit', {id: team.id}) }}" class="btn btn-sm btn-primary-icon" title="Modifier l'équipe"
                           data-controller="modal-loader"
                           data-action="click->modal-loader#open"
                           data-modal-loader-title-value="Modifier l'équipe">
                            {{ ux_icon('tabler:pencil', {height: '18', width: '18'}) }}
                        </a>
                    </div>
                    {% if members|length > 0 %}
                        <div class="team-card-members">
                            {% for member in members %}
                                {% if member.captain %}
                                    <span class="member-pill member-pill-captain">
                                        {{ ux_icon('tabler:crown', {height: '12', width: '12'}) }}
                                        <span class="member-pill-text">{{ member.name }}</span>
                                    </span>
                                {% else %}
                                    <span class="member-pill"><span class="member-pill-text">{{ member.name }}</span></span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
