{% import 'macros.html.twig' as macros %}
<div {{ attributes }}>
    {% component PageHeader with {title: 'Équipes', spacing: 3} %}
        {% block actions %}
            <div class="team-search input-icon">
                {{ ux_icon('tabler:search', {class: 'input-icon-svg'}) }}
                <input
                    type="search"
                    class="form-control"
                    placeholder="Rechercher une équipe ou un membre"
                    title="Rechercher une équipe ou un membre"
                    data-model="on(input)|search"
                    data-live-debounce="300"
                >
            </div>
            <twig:ModalLoaderLink :href="path('app_referee_team_add')" title="Nouvelle équipe" class="btn btn-primary flex-shrink-0">
                {{ ux_icon('tabler:plus', {height: '18', width: '18'}) }}&nbsp;Nouvelle équipe
            </twig:ModalLoaderLink>
        {% endblock %}
    {% endcomponent %}

    {% if this.teams is empty %}
        {{ macros.empty_state(this.search is not empty ? 'Aucune équipe ne correspond à votre recherche.' : 'Aucune équipe pour le moment.') }}
    {% else %}
        <div class="team-grid">
            {% for team in this.teams %}
                {% set members = team.members|json_decode %}
                <div class="team-card" style="border-top: 3px solid {{ team_color(team.id) }};">
                    <div class="team-card-header">
                        <span class="team-card-name">{{ team.name }}</span>
                        <twig:ModalLoaderLink :href="path('app_referee_team_edit', {id: team.id})" title="Modifier l'équipe" class="btn btn-sm btn-primary-icon">
                            {{ ux_icon('tabler:pencil', {height: '18', width: '18'}) }}
                        </twig:ModalLoaderLink>
                    </div>
                    {% if members|length > 0 %}
                        <div class="team-card-members">
                            {% for member in members %}
                                {% if member.captain %}
                                    <span class="member-pill member-pill-captain">
                                        {{ ux_icon('tabler:crown', {height: '12', width: '12'}) }}
                                        <span class="member-pill-text">{{ member.name }}</span>
                                    </span>
                                {% else %}
                                    <span class="member-pill"><span class="member-pill-text">{{ member.name }}</span></span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
