<div class="d-flex flex-column align-middle h-full">
    {% if is_granted('ROLE_REFEREE') and not this.game.finished %}
        <span class="d-flex justify-content-evenly p-1 mb-0">
            {% if not this.squareRevealed(square.id) and not this.squareVisible(row, col) %}
                <twig:IconButton icon="tabler:eye-closed" title="Révéler la case" class="btn btn-secondary" liveAction="reveal" :params="{squareId: square.id}" />
            {% else %}
                <twig:IconButton icon="tabler:eye" title="Masquer la case" class="btn btn-primary" liveAction="conceal" :params="{squareId: square.id}" :disabled="this.squareVisible(row, col)" />
            {% endif %}
            {% if this.game.inProgress %}
                {% if not this.squareValidated(square.id) %}
                    <twig:IconButton icon="mdi:remove" title="Valider la case" class="btn btn-secondary" liveAction="validate" :params="{squareId: square.id}" />
                {% else %}
                    <twig:IconButton icon="tabler:check" title="Invalider la case" class="btn btn-primary" liveAction="invalidate" :params="{squareId: square.id}" />
                {% endif %}
            {% endif %}
        </span>
    {% endif %}

    {% if is_granted('ROLE_REFEREE') or this.game.inProgress or this.game.finished %}
        <span class="d-flex flex-grow-1 justify-content-center align-items-center">
            <span>{{ this.squareContentShowable(square.id, row, col) ? square.label : '???' }}</span>
        </span>
    {% endif %}
</div>
