{% set showable = this.squareContentShowable(square.id, row, col) %}
<div class="bingo-square-content">
    {% if is_granted('ROLE_REFEREE') and not this.game.finished %}
        {# Each icon shows the current state of the square, not the next action #}
        <div class="bingo-square-actions">
            {% if not this.squareRevealed(square.id) and not this.squareVisible(row, col) %}
                <twig:IconButton icon="tabler:eye-closed" title="Révéler la case" class="bingo-square-btn is-masked" size="16" liveAction="reveal" :params="{squareId: square.id}" />
            {% else %}
                <twig:IconButton icon="tabler:eye" title="Masquer la case" class="bingo-square-btn is-revealed" size="16" liveAction="conceal" :params="{squareId: square.id}" :disabled="this.squareVisible(row, col)" />
            {% endif %}
            {% if this.game.inProgress %}
                {% if not this.squareValidated(square.id) %}
                    <twig:IconButton icon="tabler:check" title="Valider la case" class="bingo-square-btn" size="16" liveAction="validate" :params="{squareId: square.id}" />
                {% else %}
                    <twig:IconButton icon="tabler:check" title="Invalider la case" class="bingo-square-btn is-validated" size="16" liveAction="invalidate" :params="{squareId: square.id}" />
                {% endif %}
            {% endif %}
        </div>
    {% elseif this.squareValidated(square.id) and showable %}
        {{ ux_icon('tabler:check', {class: 'bingo-square-check'}) }}
    {% endif %}

    <span class="bingo-square-label">
        {%- if showable %}{{ square.label }}{% else %}<span class="bingo-square-mask">???</span>{% endif -%}
    </span>
</div>
