{% import 'macros.html.twig' as macros %}
{% set gameIndex = this.games|reduce((acc, g) => acc|merge({
    (g.season ~ '_' ~ g.round_number ~ '_' ~ g.team_id): g
}), {}) %}

{% set seasons = this.games|reduce((acc, g) =>
    g.season in acc ? acc : acc|merge([g.season]),
[])|sort|reverse %}

<div {{ attributes }}>
    {% component PageHeader with {title: 'Parties', spacing: 3} %}
        {% block actions %}
            <a href="{{ path('app_referee_game_add') }}" class="btn btn-primary">
                {{ ux_icon('tabler:plus', {height: '18', width: '18'}) }}&nbsp;Nouvelle partie
            </a>
        {% endblock %}
    {% endcomponent %}

    {% if seasons is empty %}
        {{ macros.empty_state('Aucune partie créée', false) }}
    {% else %}
        <div {{ stimulus_controller('referee--game-season-accordion') }}>
            {% for season in seasons %}
                {% set seasonId = 'game-season-' ~ season %}
                {% set isOpen = (season ~ '') in this.seasonsOpen %}

                {% set teams = this.games|filter(g => g.season == season)|reduce((acc, g) =>
                    g.team_id in acc|column('id') ? acc : acc|merge([{id: g.team_id, name: g.team_name}]),
                [])|sort((a, b) => a.name|lower <=> b.name|lower) %}

                {% set roundNumbers = this.games|filter(g => g.season == season)|reduce((acc, g) =>
                    g.round_number in acc ? acc : acc|merge([g.round_number]),
                [])|sort %}

                <div class="game-grid-season mb-3">
                    <button
                        class="season-toggle-btn d-flex align-items-center gap-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#{{ seasonId }}"
                        aria-expanded="{{ isOpen ? 'true' : 'false' }}"
                        aria-controls="{{ seasonId }}"
                    >
                        {{ ux_icon('tabler:chevron-right', {class: 'season-toggle-icon'}) }}
                        <span class="season-toggle-label">Saison {{ season }}</span>
                        <span class="badge bg-secondary-lt">{{ roundNumbers|length }} rounds</span>
                    </button>

                    <div
                        id="{{ seasonId }}"
                        class="collapse{{ isOpen ? ' show' : '' }}"
                        data-season="{{ season }}"
                        data-referee--game-season-accordion-target="panel"
                    >
                        <div class="table-responsive">
                            <table class="table table-vcenter game-grid">
                                <thead>
                                    <tr>
                                        <th class="game-grid-round-header"></th>
                                        {% for team in teams %}
                                            <th
                                                class="game-grid-team-header"
                                                title="{{ team.name }}"
                                                style="--team-color: {{ team_color(team.id) }}"
                                            >{{ team.name }}</th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for roundNumber in roundNumbers %}
                                        <tr>
                                            <td class="game-grid-round-cell">Round {{ roundNumber }}</td>
                                            {% for team in teams %}
                                                {% set key = season ~ '_' ~ roundNumber ~ '_' ~ team.id %}
                                                {% set cell = gameIndex[key] ?? null %}
                                                {% if cell is not null and cell.game_id is not null %}
                                                    <td
                                                        class="game-grid-cell game-grid-cell--clickable"
                                                        data-game-url="{{ path('app_referee_game_edit', {id: cell.game_id}) }}"
                                                        tabindex="0"
                                                    >
                                                {% else %}
                                                    <td class="game-grid-cell">
                                                {% endif %}
                                                        {% if cell is not null and cell.game_id is not null %}
                                                            <twig:GameStatusBadge :finishedAt="cell.finishedAt" :startedAt="cell.startedAt" :showDate="true" />
                                                            {{ ux_icon('tabler:pencil', {class: 'game-grid-pencil-icon'}) }}
                                                        {% endif %}
                                                    </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
