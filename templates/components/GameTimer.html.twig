<div {{ attributes.defaults(stimulus_controller('game--game-timer', {
    gameStartedAt: this.game.startedAt ? this.game.startedAt.format('U.u') : null,
    gameFinishedAt: this.game.finishedAt ? this.game.finishedAt.format('U.u') : null,
    gameTotalPausedSeconds: this.game.totalPausedSeconds,
    gameManualAdjustmentSeconds: this.game.manualAdjustmentSeconds,
    gameLastPausedAt: this.game.lastPausedAt ? this.game.lastPausedAt.format('U.u') : null,
    gameIsPaused: this.game.isPaused,
    serverTime: this.serverTime,
    serverTimeUrl: path('app_server_time')
})) }}>
    <div class="vcenter">
        <div class="me-3">
            {{ ux_icon('mdi:timer-outline', {height: '48', width: '48'}) }}
        </div>
        <div class="text-center">
            <h3 class="m-0">Temps restant</h3>
            <div class="fs-1 fw-bold" id="timer-display">
                <span data-game--game-timer-target="timerDisplay" data-live-ignore></span>
                <span data-game--game-timer-target="pauseBadge" class="badge text-bg-warning ms-2 d-none">PAUSE</span>
            </div>
            <button type="button"
                    class="btn btn-outline-warning btn-sm mt-2 d-none"
                    data-game--game-timer-target="soundButton"
                    data-action="game--game-timer#enableSound"
                    data-live-ignore>
                {{ ux_icon('mdi:volume-off') }}
                Activer le son des alertes
            </button>
        </div>
        {% if is_granted('ROLE_REFEREE') and this.game.startedAt and not this.game.finishedAt %}
            <div class="ms-3 d-flex">
                <button
                        type="button"
                        class="btn btn-icon btn-danger me-2"
                        data-bs-toggle="tooltip"
                        title="Retirer 1 minute"
                        data-action="live#action"
                        data-live-action-param="decreaseTimer">
                    {{ ux_icon('mdi:minus', {height: '24', width: '24'}) }}
                </button>

                <button
                        type="button"
                        class="btn btn-icon btn-success me-2"
                        data-bs-toggle="tooltip"
                        title="Ajouter 1 minute"
                        data-action="live#action"
                        data-live-action-param="increaseTimer">
                    {{ ux_icon('mdi:plus', {height: '24', width: '24'}) }}
                </button>

                {% if is_granted('ROLE_ADMIN') and app.request.server.get('DEBUG_TIMER') == 'true' %}
                    <button
                            type="button"
                            class="btn btn-icon btn-info me-2"
                            data-bs-toggle="tooltip"
                            title="Définir à 00:20:03"
                            data-action="live#action"
                            data-live-action-param="setTimerTo2003">
                        {{ ux_icon('mdi:timer-outline', {height: '24', width: '24'}) }}
                    </button>

                    <button
                            type="button"
                            class="btn btn-icon btn-info me-2"
                            data-bs-toggle="tooltip"
                            title="Définir à 00:10:03"
                            data-action="live#action"
                            data-live-action-param="setTimerTo1003">
                        {{ ux_icon('mdi:timer-outline', {height: '24', width: '24'}) }}
                    </button>

                    <button
                            type="button"
                            class="btn btn-icon btn-info me-2"
                            data-bs-toggle="tooltip"
                            title="Définir à 00:05:03"
                            data-action="live#action"
                            data-live-action-param="setTimerTo0503">
                        {{ ux_icon('mdi:timer-outline', {height: '24', width: '24'}) }}
                    </button>

                    <button
                            type="button"
                            class="btn btn-icon btn-info me-2"
                            data-bs-toggle="tooltip"
                            title="Définir à 00:03:03"
                            data-action="live#action"
                            data-live-action-param="setTimerTo0303">
                        {{ ux_icon('mdi:timer-outline', {height: '24', width: '24'}) }}
                    </button>

                    <button
                            type="button"
                            class="btn btn-icon btn-info me-2"
                            data-bs-toggle="tooltip"
                            title="Définir à 00:01:03"
                            data-action="live#action"
                            data-live-action-param="setTimerTo0103">
                        {{ ux_icon('mdi:timer-outline', {height: '24', width: '24'}) }}
                    </button>

                    <button
                            type="button"
                            class="btn btn-icon btn-info me-2"
                            data-bs-toggle="tooltip"
                            title="Définir à 00:00:03"
                            data-action="live#action"
                            data-live-action-param="setTimerTo0003">
                        {{ ux_icon('mdi:timer-outline', {height: '24', width: '24'}) }}
                    </button>
                {% endif %}

                {% if this.game.isPaused %}
                    <button
                            type="button"
                            class="btn btn-icon btn-success"
                            data-bs-toggle="tooltip"
                            title="Reprendre la partie"
                            data-action="live#action"
                            data-live-action-param="resumeGame">
                        {{ ux_icon('mdi:play', {height: '24', width: '24'}) }}
                    </button>
                {% else %}
                    <button
                            type="button"
                            class="btn btn-icon btn-primary"
                            data-bs-toggle="tooltip"
                            title="Mettre en pause"
                            data-action="live#action"
                            data-live-action-param="pauseGame"
                            data-game--game-timer-target="pauseButton">
                        {{ ux_icon('mdi:pause', {height: '24', width: '24'}) }}
                    </button>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
