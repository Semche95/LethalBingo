<div {{ attributes.defaults(stimulus_controller('game--game-timer', {
    timerMode: this.game.timerMode.value,
    countdownDurationSeconds: this.game.countdownDurationSeconds,
    gameStartedAt: this.game.startedAt ? this.game.startedAt.format('U.u') : null,
    gameFinishedAt: this.game.finishedAt ? this.game.finishedAt.format('U.u') : null,
    gameCountdownZeroAt: this.game.countdownZeroAt ? this.game.countdownZeroAt.format('U.u') : null,
    gamePausedRemainingSeconds: this.game.pausedRemainingSeconds,
    gameIsPaused: this.game.isPaused,
    gamePausedAt: this.game.pausedAt ? this.game.pausedAt.format('U.u') : null,
    gamePausedDurationSeconds: this.game.pausedDurationSeconds,
    serverTime: this.serverTime,
    serverTimeUrl: path('app_server_time')
})) }}>
    <twig:TimerPanel :title="this.game.stopwatch ? 'Temps écoulé' : 'Temps restant'" id="timer-display">
        <twig:block name="value">
            <span data-game--game-timer-target="timerDisplay" data-live-ignore></span>
            <span data-game--game-timer-target="pauseBadge" class="badge text-bg-warning ms-2 d-none">PAUSE</span>
        </twig:block>
        <twig:block name="below">
            {% if not outerScope.this.game.stopwatch %}
                <button type="button"
                        class="btn btn-outline-warning btn-sm mt-2 d-none"
                        data-game--game-timer-target="soundButton"
                        data-action="game--game-timer#enableSound"
                        data-live-ignore>
                    {{ ux_icon('mdi:volume-off') }}
                    Activer le son des alertes
                </button>
            {% endif %}
        </twig:block>
        <twig:block name="actions">
            {% if is_granted('ROLE_REFEREE') and outerScope.this.game.inProgress %}
                <div class="ms-3 d-flex">
                    {% if not outerScope.this.game.stopwatch %}
                        <div class="dropdown me-2" {{ stimulus_controller('game--game-timer-adjust') }}>
                            <twig:IconButton icon="mdi:timer-edit-outline" title="Ajuster le temps" class="btn btn-icon btn-outline-secondary" size="24"
                                             aria-expanded="false"
                                             data-game--game-timer-adjust-target="button"
                                             data-action="game--game-timer-adjust#toggle" />
                            <div class="dropdown-menu game-timer-adjust-menu" data-game--game-timer-adjust-target="menu">
                                <label class="form-label small text-secondary mb-1" for="game-timer-adjust-{{ outerScope.this.game.id }}">Durée (min:s)</label>
                                <input type="text" id="game-timer-adjust-{{ outerScope.this.game.id }}"
                                       class="form-control game-timer-adjust-input{{ outerScope.this.adjustDurationInvalid ? ' is-invalid' }}"
                                       value="{{ outerScope.this.adjustDuration }}" inputmode="numeric" autocomplete="off"
                                       data-game--game-timer-adjust-target="input"
                                       data-action="blur->game--game-timer-adjust#completeSeconds"
                                       data-model="norender|adjustDuration">
                                {% if outerScope.this.adjustDurationInvalid %}
                                    <div class="invalid-feedback">Format attendu : min:s, par exemple 2:30</div>
                                {% endif %}
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button" class="btn btn-outline-danger flex-fill" {{ stimulus_action('live', 'action', 'click', {action: 'decreaseTimer'}) }}>
                                        {{ ux_icon('mdi:minus', {height: '18', width: '18', class: 'me-1'}) }}Retirer
                                    </button>
                                    <button type="button" class="btn btn-outline-success flex-fill" {{ stimulus_action('live', 'action', 'click', {action: 'increaseTimer'}) }}>
                                        {{ ux_icon('mdi:plus', {height: '18', width: '18', class: 'me-1'}) }}Ajouter
                                    </button>
                                </div>
                            </div>
                        </div>

                        {% if is_granted('ROLE_ADMIN') and app.request.server.get('DEBUG_TIMER') == 'true' %}
                            {% for time in ['2003', '1003', '0503', '0303', '0103', '0003'] %}
                                <twig:IconButton icon="mdi:timer-outline" :title="'Définir à 00:' ~ time|slice(0, 2) ~ ':' ~ time|slice(2)" class="btn btn-icon btn-info me-2" :liveAction="'setTimerTo' ~ time" size="24" />
                            {% endfor %}
                        {% endif %}
                    {% endif %}

                    {% if outerScope.this.game.isPaused %}
                        <twig:IconButton icon="mdi:play" title="Reprendre la partie" class="btn btn-icon btn-success" liveAction="resumeGame" size="24" />
                    {% else %}
                        <twig:IconButton icon="mdi:pause" title="Mettre en pause" class="btn btn-icon btn-primary" liveAction="pauseGame" size="24" data-game--game-timer-target="pauseButton" />
                    {% endif %}

                    <div class="vr mx-3"></div>

                    <twig:GameHighlights :game="outerScope.this.game" />

                </div>
            {% endif %}
        </twig:block>
    </twig:TimerPanel>
</div>
