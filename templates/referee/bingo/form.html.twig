{% extends 'layouts/referee.html.twig' %}

{% form_theme form _self %}

{% block form_label_class -%}
{%- endblock form_label_class %}

{% block content %}
    {{ parent() }}
    <div class="card" {{ stimulus_controller('referee--bingo-form') }}>
        <div class="card-header">
            <h3 class="card-title">
                {% if mode == 'add' %}
                    Nouveau bingo
                {% else %}
                    Fiche du bingo
                {% endif %}
            </h3>
        </div>
        {{ form_start(form, {
            attr: {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
        <div class="card-body" id="bingo-form">
            {% for error in form.vars.errors|merge(form.squares.vars.errors) %}
                <twig:Alert>{{ error.message }}</twig:Alert>
            {% endfor %}
            {% if mode == 'edit' and (not gameRound.isComplete() or gameRound.hasIncompleteContent()) %}
                <twig:Alert type="warning" icon="alert-triangle">
                    Ce bingo est incomplet. Complétez les cases manquantes avant de pouvoir l'utiliser dans une partie.
                </twig:Alert>
            {% endif %}
            <div class="d-flex gap-3 mb-3">
                <div>
                    {{ form_label(form.round) }}
                    {{ form_widget(form.round) }}
                    {{ form_errors(form.round) }}
                </div>
                <div>
                    {{ form_label(form.season) }}
                    {{ form_widget(form.season) }}
                    {{ form_errors(form.season) }}
                </div>
            </div>
            {{ component('BingoCard', {
                'editMode': true,
                'squares': data.squares,
                'squaresFieldName': form.squares.vars.full_name,
                'duplicateCoords': duplicateCoords,
            }|merge(stimulus_target('referee--bingo-form', 'bingo').toArray())) }}
        </div>

        <div class="card-footer">
            <twig:FormFooterActions
                :backUrl="path('app_referee_bingo')"
                :deleteModalId="mode == 'edit' ? 'delete-bingo-modal' : null"
                :deleteDisabledReason="mode == 'edit' and gameRound.games is not empty ? 'Impossible de supprimer un bingo qui a des parties' : null"
            />
        </div>
        {{ form_widget(form._token) }}
        {{ form_end(form, {render_rest: false}) }}
    </div>

    {% if mode == 'edit' %}
        {% component ConfirmModal with {
            id: 'delete-bingo-modal',
            title: 'Confirmation de la suppression',
            confirmLabel: 'Supprimer',
            confirmIcon: 'trash',
            action: path('app_referee_bingo_delete', {id: gameRound.id}),
            tokenId: 'delete-bingo',
        } %}
            {% block content %}
                Supprimer le bingo <strong>{{ gameRound }}</strong>&nbsp;?
            {% endblock %}
        {% endcomponent %}
    {% endif %}
{% endblock %}
