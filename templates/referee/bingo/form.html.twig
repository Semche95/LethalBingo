{% extends 'layouts/referee.html.twig' %}

{% form_theme form _self %}

{% block form_label_class -%}
{%- endblock form_label_class %}

{% block content %}
    {{ parent() }}
    <div class="card" {{ stimulus_controller('referee--bingo-form') }}>
        <div class="card-header">
            <h3 class="card-title">
                {% if mode == 'add' %}
                    Nouveau bingo
                {% else %}
                    Fiche du bingo
                {% endif %}
            </h3>
        </div>
        {{ form_start(form, {
            attr: {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
        <div class="card-body" id="bingo-form">
            {% for error in form.vars.errors %}
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-3">
                    {{ ux_icon('tabler:alert-circle', {height: '20', width: '20', class: 'flex-shrink-0'}) }}
                    <div>{{ error.message }}</div>
                </div>
            {% endfor %}
            {% for error in form.squares.vars.errors %}
                <div class="alert alert-danger d-flex align-items-start gap-2 mb-3">
                    {{ ux_icon('tabler:alert-circle', {height: '20', width: '20', class: 'flex-shrink-0'}) }}
                    <div>{{ error.message }}</div>
                </div>
            {% endfor %}
            {% if mode == 'edit' and (not gameRound.isComplete() or gameRound.hasIncompleteContent()) %}
                <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
                    {{ ux_icon('tabler:alert-triangle', {height: '20', width: '20', class: 'flex-shrink-0'}) }}
                    <div>
                        Ce bingo est incomplet. Complétez les cases manquantes avant de pouvoir l'utiliser dans une partie.
                    </div>
                </div>
            {% endif %}
            <div class="d-flex gap-3 mb-3">
                <div>
                    {{ form_label(form.round) }}
                    {{ form_widget(form.round) }}
                    {{ form_errors(form.round) }}
                </div>
                <div>
                    {{ form_label(form.season) }}
                    {{ form_widget(form.season) }}
                    {{ form_errors(form.season) }}
                </div>
            </div>
            {{ component('BingoCard', {
                'editMode': true,
                'squares': data.squares,
                'squaresFieldName': form.squares.vars.full_name,
                'duplicateCoords': duplicateCoords,
            }|merge(stimulus_target('referee--bingo-form', 'bingo').toArray())) }}
        </div>

        <div class="card-footer">
            <div class="d-flex">
                <a href="{{ path('app_referee_bingo') }}" class="btn btn-outline-secondary">Retour</a>
                {% if mode == 'edit' %}
                    <div class="vr mx-3"></div>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                            data-bs-target="#delete-bingo-modal">
                        {{ ux_icon('tabler:trash', {height: '18', width: '18'}) }}&nbsp;Supprimer
                    </button>
                {% endif %}
                <button type="submit" class="btn btn-primary ms-auto">Enregistrer</button>
            </div>
        </div>
        {{ form_widget(form._token) }}
        {{ form_end(form, {render_rest: false}) }}
    </div>

    {% if mode == 'edit' %}
        {% component ConfirmModal with {
            id: 'delete-bingo-modal',
            title: 'Confirmation de la suppression',
            confirmLabel: 'Supprimer',
            confirmIcon: 'trash',
            action: path('app_referee_bingo_delete', {id: gameRound.id}),
            tokenId: 'delete-bingo',
        } %}
            {% block content %}
                Supprimer le bingo <strong>{{ gameRound }}</strong>&nbsp;?
            {% endblock %}
        {% endcomponent %}
    {% endif %}
{% endblock %}
