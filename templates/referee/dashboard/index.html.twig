{% extends 'layouts/referee.html.twig' %}

{% block content %}
    {{ parent() }}

    <twig:PageHeader title="Tableau de bord" subtitle="Pilotez vos parties, bingos et équipes" />

    <div class="row g-4">
        {% for card in [
            {route: 'app_referee_game', variant: 'game', icon: 'clipboard-text', title: 'Parties', desc: 'Créez et gérez vos parties de bingo', link: 'Gérer les parties'},
            {route: 'app_referee_bingo', variant: 'bingo', icon: 'grid-3x3', title: 'Bingos', desc: 'Créez et personnalisez vos grilles de bingo', link: 'Gérer les bingos'},
            {route: 'app_referee_team', variant: 'team', icon: 'user', title: 'Équipes', desc: 'Organisez et gérez vos équipes', link: 'Gérer les équipes'},
        ] %}
            <div class="col-md-4">
                <a href="{{ path(card.route) }}" class="dashboard-card dashboard-card-{{ card.variant }}">
                    <div class="dashboard-card-icon">
                        {{ ux_icon('tabler:' ~ card.icon, {height: '28', width: '28'}) }}
                    </div>
                    <h3 class="dashboard-card-title">{{ card.title }}</h3>
                    <p class="dashboard-card-desc">{{ card.desc }}</p>
                    <span class="dashboard-card-link">
                        {{ card.link }}
                        {{ ux_icon('tabler:arrow-right', {height: '16', width: '16'}) }}
                    </span>
                </a>
            </div>
        {% endfor %}
    </div>

    <h2 class="dashboard-section-title">Activité récente</h2>

    <div class="row g-4">
        {% for activity in [
            {
                variant: 'game',
                title: 'Dernières parties',
                items: recent_games|map(game => {url: path('app_referee_game_edit', {id: game.id}), label: game.team ~ ' · Round ' ~ game.round.number ~ ' Saison ' ~ game.round.season}),
                empty: 'Aucune partie créée pour l\'instant.',
                addRoute: 'app_referee_game_add',
                addLabel: 'Créer une partie',
            },
            {
                variant: 'bingo',
                title: 'Derniers bingos',
                items: recent_game_rounds|map(round => {url: path('app_referee_bingo_edit', {id: round.id}), label: 'Round ' ~ round.number ~ ' Saison ' ~ round.season}),
                empty: 'Aucun bingo créé pour l\'instant.',
                addRoute: 'app_referee_bingo_add',
                addLabel: 'Créer un bingo',
            },
            {
                variant: 'team',
                title: 'Dernières équipes',
                items: recent_teams|map(team => {url: path('app_referee_team', {id: team.id}), label: team.name}),
                empty: 'Aucune équipe créée pour l\'instant.',
                addRoute: 'app_referee_team_add',
                addLabel: 'Créer une équipe',
                modal: true,
            },
        ] %}
            <div class="col-md-4">
                <div class="activity-card">
                    <h3 class="activity-card-title activity-card-{{ activity.variant }}">{{ activity.title }}</h3>
                    {% if activity.items is not empty %}
                        <ul class="activity-list">
                            {% for item in activity.items %}
                                <li>
                                    <a href="{{ item.url }}" class="activity-item">
                                        <span class="activity-item-name">{{ item.label }}</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="activity-empty">{{ activity.empty }}
                            {% if activity.modal ?? false %}
                                <twig:ModalLoaderLink :href="path(activity.addRoute)" title="Nouvelle équipe">{{ activity.addLabel }}</twig:ModalLoaderLink>
                            {% else %}
                                <a href="{{ path(activity.addRoute) }}">{{ activity.addLabel }}</a>
                            {% endif %}
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
