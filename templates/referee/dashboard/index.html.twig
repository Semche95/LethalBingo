{% extends 'layouts/referee.html.twig' %}

{% block content %}
    {{ parent() }}

    <div class="dashboard-welcome mb-4">
        <h1 class="dashboard-title">Tableau de bord</h1>
        <p class="dashboard-subtitle">Pilotez vos parties, bingos et équipes</p>
    </div>

    <div class="row g-4">
        <!-- Parties -->
        <div class="col-md-4">
            <a href="{{ path('app_referee_game') }}" class="dashboard-card dashboard-card-game">
                <div class="dashboard-card-icon">
                    {{ ux_icon('tabler:clipboard-text', {height: '28', width: '28'}) }}
                </div>
                <h3 class="dashboard-card-title">Parties</h3>
                <ul class="dashboard-card-list">
                    <li>Consulter la liste des parties</li>
                    <li>Créer de nouvelles parties</li>
                    <li>Modifier les détails</li>
                    <li>Supprimer des parties</li>
                </ul>
                <span class="dashboard-card-link">
                    Gérer les parties
                    {{ ux_icon('tabler:arrow-right', {height: '16', width: '16'}) }}
                </span>
            </a>
        </div>

        <!-- Bingos -->
        <div class="col-md-4">
            <a href="{{ path('app_referee_bingo') }}" class="dashboard-card dashboard-card-bingo">
                <div class="dashboard-card-icon">
                    {{ ux_icon('tabler:grid-3x3', {height: '28', width: '28'}) }}
                </div>
                <h3 class="dashboard-card-title">Bingos</h3>
                <ul class="dashboard-card-list">
                    <li>Consulter tous les bingos</li>
                    <li>Créer de nouveaux bingos</li>
                    <li>Modifier les grilles</li>
                    <li>Supprimer des bingos</li>
                </ul>
                <span class="dashboard-card-link">
                    Gérer les bingos
                    {{ ux_icon('tabler:arrow-right', {height: '16', width: '16'}) }}
                </span>
            </a>
        </div>

        <!-- Équipes -->
        <div class="col-md-4">
            <a href="{{ path('app_referee_team') }}" class="dashboard-card dashboard-card-team">
                <div class="dashboard-card-icon">
                    {{ ux_icon('tabler:user', {height: '28', width: '28'}) }}
                </div>
                <h3 class="dashboard-card-title">Équipes</h3>
                <ul class="dashboard-card-list">
                    <li>Consulter les équipes</li>
                    <li>Ajouter de nouvelles équipes</li>
                    <li>Modifier les informations</li>
                    <li>Supprimer des équipes</li>
                </ul>
                <span class="dashboard-card-link">
                    Gérer les équipes
                    {{ ux_icon('tabler:arrow-right', {height: '16', width: '16'}) }}
                </span>
            </a>
        </div>
    </div>
{% endblock %}
