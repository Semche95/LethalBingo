{% extends 'layouts/base.html.twig' %}

{% block title %}Accès interdit | {{ parent() }}{% endblock %}

{% block body_classes %}d-flex flex-column min-vh-100 justify-content-center align-items-center{% endblock %}

{% block body %}
    <div class="container text-center">
        <div class="empty">
            <div class="empty-header">403</div>
            <p class="empty-title">Accès interdit</p>
            <p class="empty-subtitle text-body-secondary">
                Vous n'avez pas les permissions nécessaires pour accéder à cette page.
            </p>
            <p class="empty-action">
                <img src="{{ asset('assets/img/gifs/missed-jump.gif') }}" alt="" class="img-fluid rounded">
            </p>
            <div class="empty-action">
                <a href="{{ path('app_home') }}" class="btn btn-primary">
                    Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}
