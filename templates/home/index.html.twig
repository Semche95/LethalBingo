{% extends 'layouts/main.html.twig' %}

{% block content %}
    <!-- Hero Section -->
    <div class="hero-section mb-5">
        <div class="hero-gif-wrapper">
            <img src="{{ asset('assets/img/gifs/lethal-company.gif') }}" alt="Lethal Company" class="hero-gif">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <p class="hero-subtitle">Lethal Bingo</p>
                <p class="hero-desc">Créez, gérez et participez à des parties de bingo dans l'univers de Lethal Company.</p>
            </div>
        </div>
    </div>

    <!-- Fonctionnalités -->
    <div class="row g-4 mb-5">
        <!-- Espace joueur -->
        <div class="col-md-6">
            <div class="feature-card feature-card-player">
                <div class="feature-icon">
                    {{ ux_icon('tabler:user', {height: '28', width: '28'}) }}
                </div>
                <h3 class="feature-title">Espace joueur</h3>
                <ul class="feature-list">
                    <li>Accédez à votre grille de bingo personnelle</li>
                    <li>Suivez votre progression en temps réel</li>
                    <li>Consultez les résultats des parties terminées</li>
                </ul>
                <div class="feature-tag feature-tag-player">Accès simplifié, concentré sur le jeu</div>
            </div>
        </div>

        <!-- Espace arbitre -->
        <div class="col-md-6">
            <div class="feature-card feature-card-referee">
                <div class="feature-icon">
                    {{ ux_icon('tabler:gavel', {height: '28', width: '28'}) }}
                </div>
                <h3 class="feature-title">Espace arbitre</h3>
                <ul class="feature-list">
                    <li>Créez et gérez des parties de bingo</li>
                    <li>Configurez des grilles personnalisées</li>
                    <li>Gérez les équipes participantes</li>
                    <li>Validez les cases en temps réel</li>
                </ul>
                <div class="feature-tag feature-tag-referee">Tableau de bord complet d'administration</div>
            </div>
        </div>
    </div>

    <!-- Règles du jeu -->
    <div class="rules-card mb-5">
        <div class="rules-header">
            {{ ux_icon('material-symbols:rule', {height: '22', width: '22'}) }}
            <h3 class="rules-title">Règles du jeu</h3>
        </div>
        <div class="rules-body">
            <p class="rules-intro">Pour garantir une expérience équitable pour tous les participants :</p>
            <ul class="rules-list">
                <li>
                    <span class="rule-icon">{{ ux_icon('tabler:check', {height: '16', width: '16'}) }}</span>
                    <span>Aucun mod permis, uniquement en pure vanilla</span>
                </li>
                <li>
                    <span class="rule-icon">{{ ux_icon('tabler:check', {height: '16', width: '16'}) }}</span>
                    <span>Interdit de remake (sauf crash en début de game)</span>
                </li>
                <li>
                    <span class="rule-icon">{{ ux_icon('tabler:check', {height: '16', width: '16'}) }}</span>
                    <span>Interdit de communiquer par une autre voie que le jeu</span>
                </li>
                <li>
                    <span class="rule-icon">{{ ux_icon('tabler:check', {height: '16', width: '16'}) }}</span>
                    <span>Au début de chaque jour, sauf vente, tuer l'admin avec une pelle et laisser la pelle dans le vaisseau</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Call to action -->
    <div class="cta-section">
        {% if not is_granted('IS_AUTHENTICATED') %}
            <h3 class="cta-title">Prêt à commencer ?</h3>
            <p class="cta-desc">Connectez-vous pour accéder au tableau de bord et gérer les parties de bingo.</p>
            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg cta-btn">
                {{ ux_icon('tabler:login', {height: '20', width: '20'}) }}
                Se connecter
            </a>
        {% elseif is_granted('ROLE_REFEREE') %}
            <h3 class="cta-title">Bon retour !</h3>
            <p class="cta-desc">Accédez à votre tableau de bord pour gérer les parties.</p>
            <a href="{{ path('app_referee_dashboard') }}" class="btn btn-success btn-lg cta-btn">
                {{ ux_icon('tabler:layout-dashboard', {height: '20', width: '20'}) }}
                Tableau de bord
            </a>
        {% else %}
            <h3 class="cta-title">Bienvenue !</h3>
            <p class="cta-desc">Contactez votre arbitre pour accéder à votre grille de bingo.</p>
        {% endif %}
    </div>
{% endblock %}
