{
    "permissions": {
        "deny": [
            "Read(./.env.local)",
            "Read(./.env.*.local)",
            "Read(./config/secrets/prod/prod.decrypt.private.php)",
            "Read(./certs/*-key.pem)",
            "Edit(./.env.local)",
            "Edit(./.env.*.local)",
            "Edit(./config/secrets/prod/prod.decrypt.private.php)",
            "Edit(./certs/*-key.pem)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.sh\"",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-backlog-create.sh\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/php-cs-fix.sh\"",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
